load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//sitemap:defs.bzl", "robots_txt", "sitemap_index", "sitemap_xml")
load(
    ":failure_test.bzl",
    "bad_changefreq_test",
    "bad_disallow_test",
    "bad_lastmod_test",
    "bad_priority_test",
    "duplicate_page_test",
    "empty_index_test",
    "relative_base_url_test",
    "relative_page_test",
)
load(":render_test.bzl", "render_test_suite")

package(default_testonly = True)

render_test_suite(name = "render_tests")

# ---------------------------------------------------------------------------
# Golden tests: build the real rules and byte-compare the output.
# ---------------------------------------------------------------------------

sitemap_xml(
    name = "golden_sitemap",
    base_url = "https://example.com/",
    changefreq = "weekly",
    lastmod = "2026-08-09",
    out = "generated/sitemap.xml",
    pages = [
        "/",
        "/guides/",
        "/guides/first-post/",
        "/search?q=bazel&page=2",
    ],
    priority = "0.8",
)

diff_test(
    name = "golden_sitemap_test",
    file1 = ":golden_sitemap",
    file2 = "golden/sitemap.xml",
)

sitemap_index(
    name = "golden_index",
    base_url = "https://example.com",
    out = "generated/sitemap-index.xml",
    sitemaps = [
        "/sitemap-pages.xml",
        "/sitemap-posts.xml",
    ],
)

diff_test(
    name = "golden_index_test",
    file1 = ":golden_index",
    file2 = "golden/sitemap-index.xml",
)

robots_txt(
    name = "golden_robots",
    allow = ["/"],
    base_url = "https://example.com",
    disallow = [
        "/draft/",
        "/internal/",
    ],
    out = "generated/robots.txt",
    sitemaps = ["/sitemap-index.xml"],
    user_agents = ["*"],
)

diff_test(
    name = "golden_robots_test",
    file1 = ":golden_robots",
    file2 = "golden/robots.txt",
)

build_test(
    name = "rules_build_test",
    targets = [
        ":golden_index",
        ":golden_robots",
        ":golden_sitemap",
    ],
)

